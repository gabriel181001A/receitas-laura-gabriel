# ---- Senha ----------------------------------------------------------------
# Sem isso o app fica aberto. Obrigatório se estiver na internet.
APP_PASSWORD=

# Assina o cookie de sessão. Gere com:  node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=

# ---- Banco ----------------------------------------------------------------
# Vazio = arquivo local em data/receitas.db (ótimo para uso no PC).
# Na nuvem, use Turso (https://turso.tech) para os dados sobreviverem ao redeploy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Importação de links --------------------------------------------------
# Caminho do yt-dlp, se não estiver no PATH. O app também tenta "python -m yt_dlp".
YTDLP_PATH=

# O Instagram costuma exigir login. Exporte os cookies do navegador para um
# cookies.txt e aponte aqui para aumentar a taxa de acerto.
IG_COOKIES_FILE=

# Tempo máximo de leitura de um link, em milissegundos.
EXTRACT_TIMEOUT_MS=45000

PORT=3000
